#!/usr/bin/bash
# Installs the image's Brewfile once per Brewfile change, so formulae you
# uninstall later are not forced back.

set -euo pipefail

BREWFILE=/usr/share/aurora-base-image/Brewfile
BREW=/home/linuxbrew/.linuxbrew/bin/brew
STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/aurora-base-image/brewfile.sha256"

# Aurora sets up Homebrew on first boot; wait for it (up to 15 min)
for _ in $(seq 90); do
    [[ -x "$BREW" ]] && break
    sleep 10
done
[[ -x "$BREW" ]] || { echo "Homebrew not found at $BREW"; exit 1; }
# Homebrew belongs to one user; skip for everybody else
[[ -w "$("$BREW" --prefix)" ]] || { echo "Homebrew prefix not writable by $USER, skipping"; exit 0; }

HASH=$(sha256sum "$BREWFILE" | cut -d' ' -f1)
if [[ -f "$STAMP" && "$(cat "$STAMP")" == "$HASH" ]]; then
    exit 0
fi

"$BREW" bundle install --file="$BREWFILE"

mkdir -p "$(dirname "$STAMP")"
echo "$HASH" > "$STAMP"
